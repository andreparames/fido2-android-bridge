---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const docs = await getCollection("docs");
  return docs.map((doc) => ({
    params: { slug: doc.id },
    props: { doc },
  }));
}

const { doc } = Astro.props;
const { Content } = await render(doc);

const allDocs = (await getCollection("docs")).sort(
  (a, b) => a.data.order - b.data.order
);
const currentIndex = allDocs.findIndex((d) => d.id === doc.id);
const prev = currentIndex > 0 ? allDocs[currentIndex - 1] : null;
const next = currentIndex < allDocs.length - 1 ? allDocs[currentIndex + 1] : null;
---

<Base title={`${doc.data.title} | Gatebridge Docs`} description={doc.data.description}>
  <section class="section">
    <div class="container docs-layout">
      <aside class="docs-nav">
        <p class="docs-nav-title">Docs</p>
        <ul>
          {allDocs.map((d) => (
            <li>
              <a
                href={`/docs/${d.id}`}
                class:list={{ active: d.id === doc.id }}
              >
                {d.data.title}
              </a>
            </li>
          ))}
        </ul>
      </aside>

      <article class="prose docs-content">
        <h1>{doc.data.title}</h1>
        <p class="lead text-muted">{doc.data.description}</p>
        <Content />

        <nav class="docs-pager">
          {prev ? (
            <a href={`/docs/${prev.id}`} class="pager-link">← {prev.data.title}</a>
          ) : (
            <span></span>
          )}
          {next ? (
            <a href={`/docs/${next.id}`} class="pager-link">{next.data.title} →</a>
          ) : (
            <span></span>
          )}
        </nav>
      </article>
    </div>
  </section>
</Base>

<style>
  .docs-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  .docs-nav {
    display: none;
  }

  .docs-nav-title {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }

  .docs-nav ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .docs-nav a {
    display: block;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    text-decoration: none;
  }

  .docs-nav a:hover {
    color: var(--color-text);
    background: var(--color-surface);
  }

  .docs-nav a.active {
    color: var(--color-accent);
    background: var(--color-accent-subtle);
    font-weight: var(--weight-medium);
  }

  .docs-content {
    max-width: 68ch;
  }

  .lead {
    font-size: var(--text-lg);
    margin-top: var(--space-4);
    margin-bottom: var(--space-8);
  }

  .docs-pager {
    display: flex;
    justify-content: space-between;
    margin-top: var(--space-16);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .pager-link {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }

  @media (min-width: 900px) {
    .docs-layout {
      grid-template-columns: 220px 1fr;
    }

    .docs-nav {
      display: block;
      position: sticky;
      top: calc(var(--nav-height) + var(--space-6));
      align-self: start;
    }
  }
</style>
