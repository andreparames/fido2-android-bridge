{
  "client": {
    "token": {
      "hmac_secret_key": "REPLACE_WITH_64_HEX_CHARS"
    },
    "allowed_origins": []
  },
  "http_api": {
    "key": "REPLACE_WITH_64_HEX_CHARS"
  },
  "http_server": {
    "tls": {
      "enabled": true,
      "cert_pem": "/etc/centrifugo/example.com.fullchain.pem",
      "key_pem": "/etc/centrifugo/example.com.privkey.pem"
    }
  },
  "admin": {
    "enabled": false
  },
  "log": {
    "level": "info"
  },
  "channel": {
    "without_namespace": {
      "allow_subscribe_for_client": false,
      "allow_publish_for_client": false,
      "allow_publish_for_subscriber": false
    },
    "namespaces": [
      {
        "name": "fidobridge",
        "allow_subscribe_for_client": true,
        "allow_publish_for_client": true,
        "allow_publish_for_subscriber": true
      }
    ]
  }
}
