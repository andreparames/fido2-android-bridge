{
  "client": {
    "token": {
      "hmac_secret_key": "${HMAC_SECRET_KEY}"
    },
    "allowed_origins": []
  },
  "http_api": {
    "key": "${API_KEY}"
  },
  "admin": {
    "enabled": false
  },
  "log": {
    "level": "info"
  },
  "channel": {
    "without_namespace": {
      "allow_subscribe_for_client": true,
      "allow_publish_for_subscriber": true,
      "allow_publish_for_client": true
    }
  }
}
