# fido-daemon spec template. packaging/build.sh substitutes @VERSION@/@PYMIN@
# into rpm/fido-daemon.generated.spec, then runs rpmbuild against it.
#
# The payload is a prebuilt staging tree (packaging/stage): pure-Python + abi3
# wheels under %{_prefix}/lib/fido-daemon/pylib, a /usr/bin/fido-daemon wrapper,
# the systemd unit, udev rules, config example, and docs. Nothing is compiled
# here; the app runs on the distro python3 (>= 3.11).

%global _pymin @PYMIN@

# Fedora/RHEL define these; Debian's rpm package does not. Conditional so the
# distro's own values win where they exist.
%{!?_unitdir:%global _unitdir %{_prefix}/lib/systemd/system}
%{!?_udevrulesdir:%global _udevrulesdir %{_prefix}/lib/udev/rules.d}

# No debuginfo: the payload is a prebuilt tree, not something we compile.
%define debug_package %{nil}

# Disable build-id links (the bundled abi3 .so need no debug-link metadata).
%global _build_id_links none

Name:           fido-daemon
Version:        @VERSION@
Release:        1%{?dist}
Summary:        Remote WebAuthn Android bridge daemon
Group:          Applications/System
Packager:       Fido Daemon Team <noreply@example.com>

License:        MIT
URL:            https://github.com/andreparames/fido2-android-bridge
Source0:        fido-daemon-%{version}.tar.gz

# Runs on the distro python3 (>= 3.11) with pure/abi3 wheels under
# %{_prefix}/lib/fido-daemon/pylib; no bundled interpreter, so no libpython pin.
# cffi is Python-minor-specific and provided by the distro (needed by the
# bundled cryptography's Rust module).
Requires:       python3 >= %{_pymin}, python3-cffi, systemd, systemd-udev, passwd, shadow-utils

%description
Linux daemon that bridges local WebAuthn login requests to a remote Android
phone over an end-to-end encrypted (Noise) WebSocket relay, presenting a
virtual FIDO2 security key. Private keys stay inside the phone's hardware
enclave; neither the daemon nor the relay ever sees plain text.

%prep
%setup -q -c -n stage

%install
rm -rf %{buildroot}
mkdir -p %{buildroot}
cp -a usr etc %{buildroot}/

%pre
if ! getent group uhid >/dev/null 2>&1; then
    groupadd --system uhid || :
fi
if ! getent passwd fido-daemon >/dev/null 2>&1; then
    useradd --system \
        --home-dir /var/lib/fido-daemon \
        --shell /sbin/nologin \
        --user-group \
        fido-daemon || :
fi

%post
# Service user must be able to open /dev/uhid (udev grants the group).
usermod -aG uhid fido-daemon 2>/dev/null || :
# State directory: writable config + static identity key.
mkdir -p /var/lib/fido-daemon
chown fido-daemon:fido-daemon /var/lib/fido-daemon
chmod 0700 /var/lib/fido-daemon
# Seed the live config from the /etc example on first install.
if [ ! -e /var/lib/fido-daemon/config.toml ]; then
    cp %{_sysconfdir}/fido-daemon/fido-daemon.toml.example /var/lib/fido-daemon/config.toml
    chown fido-daemon:fido-daemon /var/lib/fido-daemon/config.toml
    chmod 0600 /var/lib/fido-daemon/config.toml
fi

%files
%{_bindir}/fido-daemon
%{_unitdir}/fido-daemon.service
%{_udevrulesdir}/70-fido2-bridge-uhid.rules
%config(noreplace) %{_sysconfdir}/fido-daemon/fido-daemon.toml.example
%{_docdir}/fido-daemon/README.md
%{_docdir}/fido-daemon/CHANGELOG.md
%{_docdir}/fido-daemon/LICENSE
%{_prefix}/lib/fido-daemon/pylib

%changelog
* Sun Oct 04 2026 Fido Daemon Team <noreply@example.com> - @VERSION@-1
- Initial packaged release.