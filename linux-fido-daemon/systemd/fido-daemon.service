[Unit]
Description=Remote WebAuthn Android Bridge Daemon
After=network.target

[Service]
Type=simple
# Run `fido-daemon pair -c ~/.config/fido-daemon/config.toml` once first; the
# config file holds the channel id, relay token, and the pinned phone key.
# Add --uhid to also expose a virtual FIDO2 HID device for browser WebAuthn.
# Requires the user's group to have access to /dev/uhid; install
# systemd/70-fido2-bridge-uhid.rules and add the user to the uhid group.
ExecStart=/usr/bin/python3 -m fido_daemon.cli -c %h/.config/fido-daemon/config.toml --socket /run/user/1000/fido2-bridge.sock
Restart=on-failure
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target