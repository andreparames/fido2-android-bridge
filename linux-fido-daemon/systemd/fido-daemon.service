[Unit]
Description=Remote WebAuthn Android Bridge Daemon
Documentation=https://github.com/andreparames/fido2-android-bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Dedicated non-privileged system user; created by the package maintainer
# scripts (postinst/%pre). Pair once first as this user:
#   sudo -u fido-daemon fido-daemon pair -c /var/lib/fido-daemon/config.toml
User=fido-daemon
Group=fido-daemon
# systemd creates /run/fido-daemon and chowns it to the service user, so the
# daemon can bind its 0600 socket inside it.
RuntimeDirectory=fido-daemon
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/fido-daemon -c /var/lib/fido-daemon/config.toml --socket %t/fido-daemon/fido2-bridge.sock
Environment=PYTHONUNBUFFERED=1
Environment=FIDO2_STATIC_KEY_PATH=/var/lib/fido-daemon/static_key.pem
Restart=on-failure
# Hardening: the daemon only needs /var/lib/fido-daemon writable (config,
# static key, pinned phone key) plus outbound websocket + local sockets.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/fido-daemon
# To also expose a virtual FIDO2 HID device for browser WebAuthn, add --uhid
# to ExecStart via `systemctl edit fido-daemon`. Requires the udev rules
# (systemd/70-fido2-bridge-uhid.rules) and the fido-daemon user in the `uhid`
# group, both set up by the package.

[Install]
WantedBy=multi-user.target